# mock 模式无需任何 Key，适合本地演示。
AI_MODE=mock
# 阿里云百炼 workspace Host 需要补上 /compatible-mode/v1。
AI_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen-plus
AI_VOCABULARY=祖安、艾欧尼亚、Nota
AI_ASR_PROVIDER=alibaba-chat
AI_ASR_MODEL=qwen3-asr-flash
ASR_MAX_BYTES=8388608
ASR_MAX_SECONDS=290
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_PORT=1883
NOTA_TIMEZONE=Asia/Shanghai
# DATA_DIR=/absolute/path/to/data

# Local MongoDB single-node replica set (transactions protect quota)
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=nota-rs
MONGODB_DATABASE=nota
AI_EMBEDDING_MODEL=text-embedding-v4
